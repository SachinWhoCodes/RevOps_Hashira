# Copy to .env for local development. Never commit .env.
# Read-zone and write-zone secrets are split on purpose (plan rule R1):
#   - worker/api read READ_* tokens and the Anthropic key
#   - executor reads WRITE_* tokens only (Phase 4, separate env file: .env.executor)

# --- Core ---
DATABASE_URL=postgresql+psycopg://casefile:casefile@localhost:5433/casefile
TEST_DATABASE_URL=postgresql+psycopg://casefile:casefile@localhost:5433/casefile_test
SESSION_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
ORG_SLUG=lumora
ORG_TIMEZONE=Asia/Kolkata

# --- Synthetic data (Phase 0) ---
SYNTH_DIR=data/synth

# --- Read-zone connector credentials (Phase 1) ---
# HubSpot: token from an app with READ scopes only
READ_HUBSPOT_TOKEN=
# Google: OAuth client + refresh token granted gmail.readonly and calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
READ_GOOGLE_REFRESH_TOKEN=
# Product usage: read-only DSN to the aggregated usage view
READ_USAGE_DSN=

# --- AI (Phase 3) ---
ANTHROPIC_API_KEY=
# Kill switch (false = template explanations only) and hard daily spend cap per org (UTC day).
AI_ENABLED=true
AI_DAILY_BUDGET_USD=2
# Propose a change set automatically once an open case has a written explanation (Phase 4).
AUTO_PLAN_CASES=true

# --- Dev admin login (written by `casefile bootstrap`; never paste it anywhere) ---
CASEFILE_ADMIN_PASSWORD=

# ============================================================================================
# Write zone (Phase 4) lives in a SEPARATE file: .env.executor (git-ignored, chmod 600).
# Only the executor process reads it (python -m casefile.executor ...). Keys:
#   WRITE_HUBSPOT_TOKEN=        HubSpot private app: create tasks/notes/deals, update deals
#   GOOGLE_CLIENT_ID=           same OAuth client as above
#   GOOGLE_CLIENT_SECRET=
#   WRITE_GOOGLE_REFRESH_TOKEN= written by `casefile google-auth --zone write` (gmail.compose)
#   SLACK_BOT_TOKEN=            xoxb-…  scopes chat:write, im:write, users:read (+ optional im:history)
#   SLACK_APP_TOKEN=            xapp-…  (Socket Mode, Phase 6 approval buttons)
#   EXECUTOR_SHADOW_MODE=false  true = record would_execute, write nothing
# ============================================================================================

# ============================================================================================
# Slack approval buttons (Phase 6.5) live in a THIRD file: .env.slackbot (git-ignored, chmod 600),
# read only by `python -m casefile.slackbot`. One key:
#   SLACK_APP_TOKEN=            xapp-…  app-level token with connections:write (Socket Mode).
# The Slack app needs Socket Mode and Interactivity turned on. Link people with
#   uv run casefile link-slack --email <user> --slack-user <U…>
# ============================================================================================
